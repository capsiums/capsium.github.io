---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import resultsData from '../../data/conformance.json' with { type: 'json' };

// Conformance matrix data. A workflow pulls
// capsium-conformance/results.json into data/conformance.json on every
// site build (script/sync-conformance.sh); the matrix renders the JSON
// at build time (Astro's native JSON import = zero runtime cost). When
// the data is missing or pre-1.0 schema, fall back to a small static
// table so the page never renders empty.
type ReactorClasses = Record<string, 'pass' | 'partial' | 'in-progress' | 'pending' | 'fail'>;
interface Reactor {
  name: string;
  repo: string;
  classes: ReactorClasses;
  last_run?: string;
  run_url?: string;
}

const reactors: Reactor[] = (() => {
  const fromFile = resultsData?.reactors;
  if (Array.isArray(fromFile) && fromFile.length > 0) return fromFile as Reactor[];
  return FALLBACK_REACTORS;
})();

const FALLBACK_REACTORS: Reactor[] = [
  {
    name: 'Ruby (capsium)',
    repo: 'capsiums/capsium',
    classes: {
      'core-reactor': 'pass',
      'signatures': 'pass',
      'encryption': 'pass',
      'layered-storage': 'pass',
      'composite': 'pass',
      'authentication': 'pass',
      'writable-packages': 'pass',
      'registries': 'pass',
      'handler-routes': 'partial',
    },
  },
  {
    name: 'Lua (capsium-lua)',
    repo: 'capsiums/capsium-lua',
    classes: {
      'core-reactor': 'pass',
      'layered-storage': 'pass',
      'composite': 'pass',
      'authentication': 'pass',
      'writable-packages': 'pass',
      'registries': 'pass',
      'signatures': 'partial',
      'encryption': 'partial',
      'handler-routes': 'pending',
    },
  },
  {
    name: 'Browser Extension (swsws)',
    repo: 'capsiums/capsium-js',
    classes: {
      'core-reactor': 'pass',
      'layered-storage': 'pass',
      'composite': 'partial',
      'writable-packages': 'pass',
      'handler-routes': 'pass',
      'signatures': 'pending',
      'encryption': 'pending',
      'authentication': 'in-progress',
      'registries': 'pending',
    },
  },
];

// The class columns are union(reactors.map(.classes)) — every
// distinct class any reactor reports. Sorted for stable ordering.
const classNames = Array.from(
  new Set(reactors.flatMap((reactor) => Object.keys(reactor.classes)))
).sort();

const statusLabels: Record<string, string> = {
  pass: 'Pass',
  partial: 'Partial',
  'in-progress': 'WIP',
  pending: '—',
  fail: 'Fail',
};

const runMeta = resultsData?.run_at
  ? {
      run_at: String(resultsData.run_at),
      sha: String(resultsData?.sha ?? ''),
      summary: resultsData?.summary as { examples?: number; failures?: number; pending?: number } | undefined,
    }
  : null;
---

<Base
  title="Conformance Matrix"
  description="CC 62001 conformance class coverage across the Capsium reactor implementations."
>
  <PageHero
    eyebrow="Conformance"
    title="Conformance Matrix"
    subtitle="Which reactors pass which CC 62001 conformance classes."
  />

  <section class="container-site py-12">
    <div class="overflow-x-auto">
      <table class="w-full border-collapse text-sm">
        <thead>
          <tr class="border-b border-ink/20 dark:border-white/10">
            <th class="py-3 pr-4 text-left font-semibold">Reactor</th>
            {classNames.map((cls) => (
              <th class="px-2 py-3 text-center font-medium text-ink/70 dark:text-cream/70">
                <span class="block max-w-[6rem]">{cls}</span>
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {reactors.map((r) => (
            <tr class="border-b border-ink/10 dark:border-white/5">
              <td class="py-3 pr-4">
                <a
                  href={`https://github.com/${r.repo}`}
                  class="font-medium text-accent hover:underline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {r.name}
                </a>
                <div class="mt-1 text-xs text-ink/50 dark:text-cream/50">
                  last run {r.last_run} · <a
                    href={r.run_url}
                    class="hover:underline"
                    target="_blank"
                    rel="noopener noreferrer"
                  >CI history ↗</a>
                </div>
              </td>
              {classNames.map((cls) => {
                const status = r.classes[cls as keyof typeof r.classes] ?? 'pending';
                const colors: Record<string, string> = {
                  pass: 'bg-green-500/15 text-green-700 dark:text-green-400',
                  partial: 'bg-yellow-500/15 text-yellow-700 dark:text-yellow-400',
                  'in-progress': 'bg-blue-500/15 text-blue-700 dark:text-blue-400',
                  pending: 'bg-gray-500/10 text-gray-500',
                };
                return (
                  <td class="px-2 py-3 text-center">
                    <span
                      class={`inline-block rounded px-2 py-0.5 text-xs font-medium ${colors[status] ?? colors.pending}`}
                    >
                      {statusLabels[status] ?? '—'}
                    </span>
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <div class="mt-8 text-sm text-ink/60 dark:text-cream/60">
      <p>
        The conformance kit (<a
          href="https://github.com/capsiums/capsium-conformance"
          class="text-accent hover:underline"
          target="_blank"
          rel="noopener noreferrer"
        >capsium-conformance</a>) tests each reactor against CC 62001's
        conformance classes. A reactor claiming a class MUST pass every
        expectation for that class. See <a
          href="/specifications"
          class="text-accent hover:underline"
        >the specification</a> for the normative requirements.
      </p>
      {runMeta && (
        <p class="mt-2 text-xs">
          Last synced at <span class="font-medium">{runMeta.run_at}</span>
          {runMeta.summary && (
            <>
              {' '}— {runMeta.summary.examples ?? '—'} expectations,
              {' '}{runMeta.summary.failures ?? 0} failures,
              {' '}{runMeta.summary.pending ?? 0} pending
            </>
          )}
          . Source: <a
            class="text-accent hover:underline"
            href={`https://github.com/capsiums/capsium-conformance/blob/main/results.json`}
            target="_blank"
            rel="noopener noreferrer"
          >results.json</a>.
        </p>
      )}
      <p class="mt-4">
        Status legend: <span class="font-medium text-green-700 dark:text-green-400">Pass</span> =
        all expectations green; <span class="font-medium text-yellow-700 dark:text-yellow-400">Partial</span> =
        some expectations pass, some pending; <span class="font-medium text-blue-700 dark:text-blue-400">WIP</span> =
        implementation in progress; <span class="font-medium text-gray-500">—</span> = not yet started.
      </p>
    </div>
  </section>
</Base>
